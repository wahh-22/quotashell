<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp">
    <TextView android:id="@+id/window_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:textColor="#F0F4FA" android:textSize="12sp" />
    <ImageView android:id="@+id/window_bar" android:layout_width="match_parent"
        android:layout_height="8dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/window_reset" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:textColor="#DDE7F0" android:textSize="11sp" />
</LinearLayout>
