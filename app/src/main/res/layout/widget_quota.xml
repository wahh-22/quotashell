<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_board" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@string/open_dashboard" />
    <TextView android:id="@+id/widget_refresh" android:layout_width="72dp" android:layout_height="32dp"
        android:layout_gravity="top|end" android:contentDescription="@string/refresh" />
</FrameLayout>
