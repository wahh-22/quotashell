<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#E60A1018">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:contentDescription="@string/open_dashboard"
        android:fontFamily="monospace" android:text="@string/app_name" android:textColor="#2196F3" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:text="@string/initial_widget_state" android:textColor="#F0F4FA" android:textSize="12sp" />
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:text="@string/no_quota_windows" android:textColor="#DDE7F0" android:paddingTop="8dp" android:textSize="12sp" />
    <LinearLayout android:id="@+id/widget_windows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/widget_inventory" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:textColor="#F0F4FA" android:textSize="12sp" android:paddingTop="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:gravity="center_vertical" android:fontFamily="monospace" android:text="@string/refresh" android:textColor="#DDE7F0" />
        <TextView android:id="@+id/widget_settings" android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center_vertical" android:fontFamily="monospace" android:text="@string/settings" android:textColor="#DDE7F0" />
    </LinearLayout>
</LinearLayout>
