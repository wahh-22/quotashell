<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="#E60A1018">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:contentDescription="@string/open_dashboard" android:maxLines="1" android:ellipsize="end"
            android:fontFamily="monospace" android:text="@string/app_name" android:textColor="#2196F3" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="28dp"
            android:contentDescription="@string/refresh" android:gravity="center"
            android:fontFamily="monospace" android:text="@string/refresh_icon" android:textColor="#DDE7F0" android:textSize="16sp" />
        <TextView android:id="@+id/widget_settings" android:layout_width="32dp" android:layout_height="28dp"
            android:contentDescription="@string/settings" android:gravity="center"
            android:fontFamily="monospace" android:text="@string/settings_icon" android:textColor="#DDE7F0" android:textSize="16sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end"
        android:fontFamily="monospace" android:text="@string/initial_widget_state" android:textColor="#F0F4FA" android:textSize="11sp" />
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:text="@string/no_quota_windows" android:textColor="#DDE7F0" android:paddingTop="4dp" android:textSize="11sp" />
    <LinearLayout android:id="@+id/widget_windows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/widget_inventory" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end"
        android:fontFamily="monospace" android:textColor="#F0F4FA" android:textSize="11sp" android:paddingTop="2dp" />
</LinearLayout>
